{
  "name": "environment-maintenance",
  "version": "5.3.10",
  "description": "Инструмент обслуживания окружения по конфигурации",
  "bin": {
    "start-app": "src/npm-start-app.cjs"
  },
  "scripts": {
    "install": "node src/npm-install.cjs"
  },
  "dependencies": {
    "command-execution": "2.0.10"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "os": [
    "linux"
  ],
  "files": [
    "pyproject.toml",
    "vendor/*.whl",
    "vendor/SHA256SUMS",
    "MANIFEST.in",
    "start-app",
    "src/**/*.py",
    "src/npm-*.cjs",
    "docs/**/*.md",
    "docs/**/*.sql",
    "examples/**/*.py",
    "examples/**/*.json",
    "examples/**/*.md",
    "tests/**/*.py",
    "tests/**/*.json",
    "tests/**/*.sh",
    "tests/**/*.md",
    "tests/**/*.hex",
    "tests/**/*.txt",
    ".agents/skills/environment-maintenance/SKILL.md",
    "src/environment_maintenance/resources/commands/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SbWereWolf/environment-maintenance.git"
  }
}
