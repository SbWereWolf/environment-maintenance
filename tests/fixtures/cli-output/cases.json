  "F05": [
    {
      "argv": [
        "infra",
        "--requirements",
        "[\"beta\"]",
        "--output",
        "wide"
      ],
      "expected": "warning precedes INVOCATION_BOUNDARY marker; exit0; exactly beta effect."
    },
    {
      "argv": [
        "infra",
        "--requirements",
        "[broken"
      ],
      "expected": "warning, exit2, no INVOCATION_BOUNDARY marker and no effects."
    },
    {
      "argv": [
        "infra",
        "--requirements",
        "[\"beta\",\"beta\"]"
      ],
      "expected": "warning with beta and duplicate-remedy context, exit2, no INVOCATION_BOUNDARY marker and no effects."
    },
    {
      "argv": [
        "infra",
        "--config"
      ],
      "expected": "warning, exit2, no INVOCATION_BOUNDARY marker and no effects."
    }
  ],
  "F06": [
    {
      "id": "servicing-streams",
      "action": "infra --requirements [\"beta\"] --output",
      "expected": "exit0; requirement IDs=[beta]; events=[beta]; decoded action stdout/stderr equal the literal hex profile; full command context and original file bytes preserved."
    },
    {
      "id": "checking-streams",
      "action": "check --output",
      "expected": "exit0; events=[presence-alpha,presence-beta,presence-vendor,extra]; resource IDs=[alpha,beta,vendor], check IDs=[extra]; presence/check raw bytes preserved; availability remains not_configured with null result/reason."
    },
    {
      "id": "run-and-selected-stop",
      "action": "run --env OUTPUT --app B --output, then stop --env OUTPUT --app B --output",
      "expected": "Only B starts; independent B.started.json and living_group identify its PGID; registry contains exactly B. Results carry that exact own PGID and selected IDs. Stop actually ends that group, confirms fixture SIGTERM handshake and removes only the owned empty environment; no A/C worker."
    },
    {
      "id": "servicing-failure",
      "action": "infra with one selected fail-mode command and --output pretty",
      "expected": "exit1; JSON status failed; attempted command exit7 and literal failure stderr retained; no success fabricated and no parser warning for an operational failure."
    },
    {
      "id": "run-failure",
      "action": "run --env FAILED --app A --output pretty with fail-mode launch",
      "expected": "exit1; failed JSON and attempted command exit7/raw stderr retained; no registered PGID or live worker; owned empty reservation removed."
    },
    {
      "id": "run-input-json",
      "action": "run --env INPUT --config known-missing-path --parameters VALUES --base-dir ROOT --output pretty",
      "expected": "exit2; pretty JSON failed with INPUT environment, no applications, no PGID and actual input cause; diagnostic on stderr without a fabricated parser-warning category for the syntactically valid missing path; zero effects."
    },
    {
      "id": "check-input-stderr",
      "action": "check --config known-missing-path --parameters VALUES --base-dir ROOT --output pretty",
      "expected": "exit2; stdout stays empty; actual missing-file input cause on stderr; no JSON envelope invented and zero effects."
    }
  ],
